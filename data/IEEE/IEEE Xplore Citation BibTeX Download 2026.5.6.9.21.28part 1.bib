  author={Wahyudin, Didin and Lestari, Tika and Haritman, Erik},
  booktitle={2024 9th International STEM Education Conference (iSTEM-Ed)}, 
  title={Implementation Model of Capstone Project Through Collaborative Project-Based Learning Using Application of Project Management}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Capstone Project (CP) is a project-based learning method (PbL) that enables students to utilize the information acquired in college to solve real-world problems. There are still deficiencies in implementing CP within the Outcomes-Based Education (OBE) curriculum. According to OBE curricular standards, process improvements are necessary to achieve precise and measurable learning outcomes. The OBE curriculum focuses on learning outcomes and the difficulties of establishing achievement standards and accurate evaluation. This study examines the CP implementation paradigm using the project management application (PMA). Implementing CP online presents challenges such as coordination, time management, and tracking of project progress. This study uses a quantitative research design with a survey approach to investigate PMA's efficacy in implementing CP. The research involved 156 participants chosen using purposive sampling methods. The research questionnaire assesses student motivations, participation, and partnerships. Data analysis shows that PMA positively affects student motivation, engagement, and cooperation, strengthening the CP process. The results offer significant information for making informed judgments and improving educational practices to improve student learning outcomes and overall academic quality.},
  keywords={Surveys;Learning systems;Education;Collaboration;Project management;Sampling methods;Planning;collaborative capstone project;project management application;student motivations;student engagement;collaborations},
  doi={10.1109/iSTEM-Ed62750.2024.10663199},
  ISSN={},
  month={July},}@INPROCEEDINGS{10062570,
  author={Li, Pengyu and Xing, Yanxia and Li, Wei},
  booktitle={2022 International Conference on Information Processing and Network Provisioning (ICIPNP)}, 
  title={Distributed AI-native Architecture for 6G Networks}, 
  year={2022},
  volume={},
  number={},
  pages={57-62},
  abstract={How to achieve native intelligence in 6G networks has attracted widespread attention and discussion in the communication field. In the core network, NWDAF (Network Data Analytics Function) is introduced as an AI (Artificial Intelligence) service NF (Network Function) to provide intelligence analysis, such as supporting network load and congestion prediction, UE behavior, and service experience statistics. However, there are still problems such as the lack of AI capability of NFs (Network Functions), weak cross-domain collaboration, and little support for distributed learning methods, etc. This paper presents our solutions on native intelligence in 6G networks, including the overall distributed network architecture of native intelligence, emphasizing the capabilities of each intelligent node and the collaboration among nodes, and further proposes some thoughts and potential solutions from the perspective of cross-domain coordination, and the combination of distributed learning and the network.},
  keywords={6G mobile communication;Training;Computer aided instruction;Distance learning;Collaboration;Distributed databases;Information processing;6G;AI-native;Distributed AI;Edge AI},
  doi={10.1109/ICIPNP57450.2022.00019},
  ISSN={},
  month={Sep.},}@ARTICLE{11214155,
  author={Seo, Sungjun and Lee, Kooktae},
  journal={IEEE Transactions on Systems, Man, and Cybernetics: Systems}, 
  title={Density-Driven Optimal Control for Efficient and Collaborative Multiagent Nonuniform Coverage}, 
  year={2025},
  volume={55},
  number={12},
  pages={9340-9354},
  abstract={This article addresses the critical challenge of nonuniform area coverage in multiagent systems, where certain regions require higher priority based on mission objectives. Traditional uniform coverage methods are often inadequate in many area coverage scenarios, as they may overlook real-world complexities where uniform coverage is neither feasible nor desirable. Although several nonuniform coverage methods exist, they frequently lack guarantees of optimality or fail to consider essential real-world constraints such as agent dynamics, the number of agents, available operation time, and decentralized control. To overcome these limitations, a novel control scheme called density-driven optimal control (D2OC) is proposed. The key innovation of D2OC lies in the integration of optimal transport (OT) theory with multiagent control, allowing agents to dynamically adjust their coverage according to a reference density distribution that reflects the mission’s priorities. Optimality is guaranteed by solving an optimization problem that incorporates the aforementioned real-world constraints. The control law is derived from the Lagrangian associated with the objective cost, utilizing OT for both linear and nonlinear systems. Guarantees for global optimality and the existence of the optimal control input for linear systems are provided through an analytic solution. In addition, an efficient data-sharing algorithm for decentralized control among multiple agents is proposed. To evaluate the efficacy of the proposed control scheme, various simulation results are presented to compare its performance with existing methods.},
  keywords={Multi-agent systems;Optimal control;Costs;Transportation;Trajectory;Mathematical models;Collaboration;Symbols;Optimization;Collaborative control;decentralized multiagent coverage;multiagent system;nonuniform area coverage},
  doi={10.1109/TSMC.2025.3622075},
  ISSN={2168-2232},
  month={Dec},}@INPROCEEDINGS{7427863,
  author={Anderson, Jennings and Soden, Robert and Anderson, Kenneth M. and Kogan, Marina and Palen, Leysia},
  booktitle={2016 49th Hawaii International Conference on System Sciences (HICSS)}, 
  title={EPIC-OSM: A Software Framework for OpenStreetMap Data Analytics}, 
  year={2016},
  volume={},
  number={},
  pages={5468-5477},
  abstract={An important area of work in big data software engineering involves the design and development of software frameworks for data-intensive systems that perform large-scale data collection and analysis. We report on our work to design and develop a software framework for analyzing the collaborative editing behavior of OpenStreetMap users when working on the task of crisis mapping. Crisis mapping occurs after a disaster or humanitarian crisis and involves the coordination of a distributed set of users who collaboratively work to improve the quality of the map for the impacted area in support of emergency response efforts. Our paper presents the challenges related to the analysis of OpenStreetMap and how our software framework tackles those challenges to enable the efficient processing of gigabytes of OpenStreetMap data. Our framework has already been deployed to analyze crisis mapping efforts in 2015 and has an active development community.},
  keywords={Databases;Buildings;Software;Collaboration;Organizations;Informatics;History;big data software engineering;OpenStreetMap;data analytics},
  doi={10.1109/HICSS.2016.675},
  ISSN={1530-1605},
  month={Jan},}@INPROCEEDINGS{11217674,
  author={Boadi-Agyemang, Abena and Schaldenbrand, Peter and Misra, Vihaan and Carter, Elizabeth J. and Oh, Jean and Steinfeld, Aaron},
  booktitle={2025 34th IEEE International Conference on Robot and Human Interactive Communication (RO-MAN)}, 
  title={If I Move, Do You Move? Investigating the Role of Interpersonal Synchrony in Human-Robot Joint Painting}, 
  year={2025},
  volume={},
  number={},
  pages={728-735},
  abstract={Interpersonal synchrony (IS), the behavioral and physiological coordination across time and space, plays a crucial role in social interactions by fostering empathy, closeness, and prosocial behaviors. However, there is a need for more examination of human-robot interaction (HRI) research focused on interactions where the temporal alignment of body movements and the spatial coordination of the content produced by those movements is vital to the quality of the interaction, such as in joint visual art-making. In this work, we investigated the impact of IS on human raters’ perceptions of a human-robot (HR) dyad engaged in a joint painting activity. We conducted two online studies (n = 70, total) in which participants watched 4 videos (1 repeated synchronous video and 3 asynchronous videos). We varied the degree of IS displayed by an HR dyad on two axes: (a) temporal alignment (e.g., speed of producing brush strokes) and (b) spatial similarity (i.e., similarity in the visual content produced). Our results indicate that some temporal and spatial dimensions of IS displayed by an HR dyad during joint painting have significant positive impacts on external observers’ perceptions of the robot, including prosocial tendencies (i.e., empathy, synchrony, and closeness) and acceptance. These findings are significant for emergent research on collaborative robots.},
  keywords={Visualization;Art;Robot kinematics;Human-robot interaction;Collaborative robots;Observers;Physiology;Videos;Painting},
  doi={10.1109/RO-MAN63969.2025.11217674},
  ISSN={1944-9437},
  month={Aug},}@INPROCEEDINGS{10074583,
  author={Lee, Junghwan and Jang, Seongsu},
  booktitle={2023 International Conference on Computing, Networking and Communications (ICNC)}, 
  title={Metaverse-based education service adoption and preference study using conjoint analysis}, 
  year={2023},
  volume={},
  number={},
  pages={273-277},
  abstract={This study analyzed the possibility and detailed properties of the metaverse-based new educational service that can lead the untact and non-face-to-face innovation of university education in the post-corona era. For this purpose, evaluation responses were collected from 120 college students in Korea and analyzed using the conjoint method. As a result of the survey, the intention to use the metaverse-based education service was high at 85%. And, it is considered relatively important in service selection, and the attributes are the personal character display method (27.6%), the educational application area (22.7%), the service usage fee (19.1%), the device type (17.4%), and the educational value (13.2%).) appeared in that order. In particular, college students showed the highest preference for metaverse-based educational services available at a price of less than 5 dollar per month through virtual classrooms while showing themselves as 3D-based avatar-type characters on a web-based PC. The results of this study are meaningful in providing basic data suggesting ways to utilize metaverse to innovate university education.},
  keywords={Technological innovation;Metaverse;Education;Lead;Metaverse;virtual reality;education;conjoint analysis;Application},
  doi={10.1109/ICNC57223.2023.10074583},
  ISSN={},
  month={Feb},}@ARTICLE{11267436,
  author={Khodaparas, Sahand and Benslimane, Abderrahim and Yousefi, Saleh and Assi, Chadi},
  journal={IEEE Internet of Things Journal}, 
  title={Optimized UAV Deployment and Blockchain-Based Caching: A Reinforcement Learning Framework}, 
  year={2026},
  volume={13},
  number={4},
  pages={5869-5884},
  abstract={Within the rapidly expanding Internet of Vehicles (IoV) landscape, the demand for network services to accommodate data-intensive applications has become increasingly paramount. However, IoV faces significant challenges, including high latency, limited coverage in remote areas, network congestion, and privacy concerns in content popularity prediction. To address these challenges, we introduce the scalable optimization for networked aerial vehicles (SONA) scheme, which reduces latency through advanced caching techniques while enhancing coverage and ensuring required data rates using uncrewed aerial vehicles (UAVs). UAVs are deployed to augment coverage in areas lacking roadside unit (RSU) support and to assist in scenarios where RSUs are overwhelmed, ensuring continuous data rate provision. Our scheme introduces a novel mathematical optimization model and machine learning algorithms: federated learning (FL) to collaboratively predict content popularity without exposing user data, reinforcement learning (RL) to dynamically optimize UAV placement and energy-efficient deployment, and blockchain to enable secure, decentralized coordination between RSUs and UAVs for real-time decision-making. Simulation results demonstrate the effectiveness of our approach, achieving an average delay of 8 ms, an average cache hit rate of 88.43%, and satisfying desired data rate requirements in 84.85% of scenarios, significantly improving IoV performance.},
  keywords={Autonomous aerial vehicles;Blockchains;Optimization;Vehicle dynamics;Federated learning;Quality of service;Collaboration;Resource management;Security;Real-time systems;Blockchain;caching;Internet of Vehicles (IoV);reinforcement learning (RL);uncrewed aerial vehicles (UAVs)},
  doi={10.1109/JIOT.2025.3636738},
  ISSN={2327-4662},
  month={Feb},}@ARTICLE{11456977,
  author={Durdu, Uguray and Kemalbay, Gulder},
  journal={IEEE Access}, 
  title={Metadata-Integrated Deep Semi-Autoencoder for Implicit-Feedback Recommendation Under Data Sparsity and Cold Start}, 
  year={2026},
  volume={14},
  number={},
  pages={47990-48008},
  abstract={Collaborative filtering under implicit feedback suffers from data sparsity and cold start, degrading ranking quality. The basic semi-autoencoder (BSAE) integrates metadata to improve top- $k$  performance, but its single-hidden-layer design may limit the ability to capture higher-order user–item relations. A training algorithm dense re-feeding has been introduced in prior work for deep autoencoders to mitigate sparsity, but it operates on reconstructed interactions and does not use metadata, so its value in hybrid settings remains unclear. To address this gap, we propose a deep semi-autoencoder (DSAE) for implicit-feedback recommender systems that uses depth as an inductive bias to hierarchically separate and recompose interaction and metadata signals, improving top-10 ranking under data sparsity and cold start. We adapt dense re-feeding to our hybrid DSAE by re-feeding only the reconstructed interaction block while keeping metadata fixed. Then, we train this variant (DSAE+RA) to quantify any incremental benefit. DSAE is trained with binary cross-entropy and selected by validation NDCG@10 with early stopping. We select capacity and depth in two stages, using information criteria only as tie-breakers. All experiments follow a reproducible user-level 70/15/15 split with cold-item filtering and full-item evaluation without negative sampling. In MovieLens-1M, DSAE outperforms BSAE, DSAE+RA, and a variational baseline (Mult-VAE) on validation and test; achieving the test NDCG@ $10{\,}{=}{\,}0.866$ , Precision@ $10{\,}{=}{\,}0.833$ , Recall@ $10{\,}{=}{\,}0.092$ , and mAP@ $10{\,}{=}{\,}0.170$ . Robustness is assessed through threshold sensitivity, sparsity-faithfulness analysis at  $\tau =3.5$ , metadata ablations, and bucketed cold-start evaluations over user interaction-frequency regimes. The results indicate that dense re-feeding can aid a shallow baseline, whereas DSAE yields stronger and more stable top-10 ranking under sparsity and cold-start conditions.},
  keywords={Metadata;Autoencoders;Recommender systems;Decoding;Training;Collaborative filtering;Vectors;Robustness;Sparse matrices;Collaboration;Autoencoders;cold-start problem;collaborative filtering;data sparsity;implicit feedback;metadata;recommender systems;top-N recommendation},
  doi={10.1109/ACCESS.2026.3678156},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11297383,
  author={Zhang, Chi and Li, Hao and Zhang, Tong and Bai, Yang},
  booktitle={2025 Low-Altitude Economy Forum & International Conference on Low-Altitude Flight Technology and Unmanned Aerial Vehicle Application (LEF & ICLU)}, 
  title={Research on Analysis and Optimization Model of Cross-Domain Heterogeneous Unmanned Cluster Cooperative Operation Efficiency}, 
  year={2025},
  volume={},
  number={},
  pages={26-31},
  abstract={With the rapid development of modern industrial technology, cross - domain heterogeneous unmanned cluster equipment plays an increasingly important role in various fields. However, efficient collaborative effectiveness analysis and optimization of such equipment face challenges due to equipment heterogeneity, cross - domain communication complexity, and task execution dynamics. This paper proposes a cross - domain heterogeneous unmanned cluster collaborative effectiveness analysis and optimization model. First, an evaluation index system is constructed, including deployment mobility, system comprehensive, strike, protection and survival, and synergistic operation effect capabilities, with each indicator quantified. Then, the dimensionality reduction of the index system is carried out using principal component analysis. Based on the reduced - dimensional vectors, Data Envelopment Analysis is performed to select the optimal cluster configuration scheme from existing ones. Finally, in order to maximize the effectiveness of equipment collaboration, it is necessary to continue exploring the optimal space for equipment coordination. Therefore, a further analysis is conducted on the optimal equipment coordination scheme obtained through Data Envelopment Analysis. By applying the model method of index classification, the grades of the selected best unmanned equipment matching scheme and the distribution of each index are calculated, thereby obtaining the capability items that need to be optimized in the cluster. This research aims to enhance the operational efficiency and task completion quality of cross-domain heterogeneous unmanned cluster system. The research outcomes can be utilized to guide the commanders, users and manufacturers of unmanned swarm equipment to optimize the performance of cross-domain heterogeneous unmanned swarms.},
  keywords={Optimization models;Collaboration;Vectors;Space exploration;Indexes;Protection;Optimization;Faces;Data envelopment analysis;Principal component analysis;Cross-domain heterogeneous cluster;Efficacy assessment;Efficiency optimization},
  doi={10.1109/LEFICLU65987.2025.11297383},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11229577,
  author={Tang, Jiayue and Yang, Li and Yu, Lei and Lu, Junyi and Huang, Zhirong and Zhang, Fengjun and Zuo, Chun},
  booktitle={2025 IEEE 36th International Symposium on Software Reliability Engineering (ISSRE)}, 
  title={Breaking Task Isolation: Enhancing Code Review Automation with Mixture-of-Experts Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={227-238},
  abstract={The automation of code review activities has emerged as a critical research focus for optimizing development efficiency while ensuring code quality. While recent advancements in Large Language Models (LLMs) have shown promise, existing approaches predominantly isolate the three core code review tasks—review necessity prediction, review comment generation, and code refinement, overlooking their valuable interdependencies. Empirical analysis reveals that isolated-trained comment-generation models often produce superficial comments (e.g., “Undefined ‘userInput’”) due to insufficient understanding of defect patterns, which is what necessity prediction tasks precisely target. Recent efforts to model interdependencies through knowledge distillation remain constrained by static framework designs.To address these challenges, we present MoE-Reviewer, which adopts the Mixture-of-Experts (MoE) framework on the LLaMA model to tackle the interdependence of code review tasks. MoE-Reviewer enables collaborative modeling for the three tasks mentioned above. By integrating dynamic coordination routing strategies and fine-grained expert mechanisms, MoE-Reviewer facilitates effective knowledge sharing across tasks while mitigating parameter interference. Evaluations conducted on the CodeReviewer dataset demonstrated that MoE-Reviewer outperforms existing methods, achieving state-of-the-art performance with an F1-score of 73.2% and improving the BLEU score for review comment generation by 5.32 to 11.62. Additionally, routing analysis further validates the effectiveness of our approach.},
  keywords={Analytical models;Codes;Automation;Reviews;Large language models;Collaboration;Interference;Predictive models;Routing;Software reliability;Code Review Automation;Large Language Models;Mixture-of-Experts},
  doi={10.1109/ISSRE66568.2025.00033},
  ISSN={2332-6549},
  month={Oct},}@INPROCEEDINGS{10731082,
  author={Li, Wenfeng and Guo, Genghao},
  booktitle={2024 IEEE 3rd World Conference on Applied Intelligence and Computing (AIC)}, 
  title={Research on the Application of Network Slicing Technology in the Collaborative Optimization of 4/5G Networks}, 
  year={2024},
  volume={},
  number={},
  pages={661-665},
  abstract={In the transition phase of coexistence between 4G and 5G networks during the early commercialization of 5G, achieving synergy and optimization between the two networks is an important issue. Based on the analysis of the ability of network slicing technology to achieve business differentiation isolation and QoS guarantee, this paper studies the characteristics of hybrid 4/5G network architecture, capacity evaluation models, and wireless resource optimization problems, and points out the challenges faced in optimizing the coordination performance of hybrid networks. On this basis, a network slicing-based collaborative approach for 4/5G networks is designed: using SDN controllers to uniformly schedule and manage multiple slice instances of 4G and 5G core networks, deploying traffic engineering to achieve slice-level business isolation and QoS mapping, and improving overall service performance through dynamic configuration of wireless resources, interference coordination based on SINR, and differentiated priority scheduling. Simulation results show that the proposed solution can significantly enhance the throughput and QoS of hybrid 4/5G networks, providing important insights into network optimization design and guiding network evolution strategies for 5G commercialization.},
  keywords={Wireless communication;5G mobile communication;Network slicing;Collaboration;Quality of service;Interference;Dynamic scheduling;Throughput;Optimization;Business;5G Networks;4G Networks;Network Slicing;Resource Management},
  doi={10.1109/AIC61668.2024.10731082},
  ISSN={},
  month={July},}@INPROCEEDINGS{11126803,
  author={Guo, Zhen-Yang and Chen, Shuo-Han and Garland, Andrew and Chen, Wei-Hao and Liang, Yu-Pei and Liu, Chuan-Ming},
  booktitle={2025 IEEE 49th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={Facilitating the Merging Process of Pull Requests in Automated-Testing Robot Framework}, 
  year={2025},
  volume={},
  number={},
  pages={2313-2318},
  abstract={Robot Framework is a keyword-driven test automation framework that is widely used for acceptance test-driven development to verify software systems’ functionality and quality. While automated testing scripts are developed to verify the functionalities of software systems (i.e., web services), ensuring the maintainability and correctness of automated testing scripts is vital in large-scale software projects, especially when multiple teams collaboratively develop test scripts in parallel. In this paper, we focus on how to facilitate the merging of pull requests (PRs) for projects that use the Robot Framework. We present findings from a two-year industry-academia collaboration involving three concurrently working teams, each consisting of six to eight members developing testing scripts for web services. Through detailed analysis of PR merging workflows, keyword usage patterns, and team coordination practices, we identify common bottlenecks, such as conflicting keyword dependency and unaligned script styles, that hinder efficient merging. Although the teams employ a Kanban approach, which helps limit tasks in progress, visualize workflows, and aim for continuous improvement, significant delays arose at the “Waiting for Merge” stage. Some pull requests remained unmerged for over a month, while more complex test cases could take up to two months. Our study proposes a set of best practices and an automated tool to streamline PR reviews, reduce merge conflicts, and enhance script maintainability. We discuss the observed outcomes, including improved collaboration metrics and reduced integration overhead, offering actionable insights for practitioners and researchers working with Robot Framework in multi-team environments.},
  keywords={Visualization;Codes;Web services;Reviews;Service robots;Robot kinematics;Merging;Collaboration;Software systems;Testing;robot framework;automated script testing;mob programming;scrum;dependency},
  doi={10.1109/COMPSAC65507.2025.00326},
  ISSN={2836-3795},
  month={July},}@ARTICLE{11429108,
  author={Tong, Haogang and Meng, Chunyang and Song, Shijie and Pan, Maolin and Yu, Yang},
  journal={IEEE Transactions on Services Computing}, 
  title={SynScale: Spatiotemporal Collaborative Autoscaling for Microservices in Edge-Clouds}, 
  year={2026},
  volume={},
  number={},
  pages={1-14},
  abstract={Edge-cloud environments constitute a heterogeneous computing paradigm that integrates resource-constrained edge servers with high-performance cloud servers. While microservices have revolutionized large-scale applications development by enhancing scalability and flexibility, achieving efficient microservice autoscaling—the dynamic adjustment of instances to maintain quality of service (QoS) and meet service-level agreements (SLA) targets—remains challenging in such environments. Most existing autoscaling techniques rely on metric forecasting and centralized or per-node control, causing them to overlook temporal evolution and server relationships and resulting in unstable and weakly coordinated scaling. To address these challenges, we present SynScale, a distributed collaborative autoscaling framework that strengthens both temporal sensitivity and structural coordination. SynScale introduces a spatiotemporal representation module that couples a temporal attention network with a multi graph convolutional model. The temporal component distills behavioral trends from recent observations to ensure coherent responses to time-varying dynamics, while the spatial component performs relational reasoning over explicitly modeled inter server correlations to yield structure-aware representations that support effective cross-node coordination. These spatiotemporal embeddings are then used within a multi-agent reinforcement learning paradigm, enabling distributed agents to generate context-aware scaling decisions that align local adaptability with system-wide efficiency. Experimental evaluations against state of-the-art autoscaling techniques show that SynScale reduces average response time by 59.32%, SLA violations by 85.71%, and P95 latency by 73.2%, while also lowering resource cost. It further improves scaling stability—reflected by lower instance time and longer instance lifetimes—and maintains lightweight, scale-stable runtime overhead, ensuring practical deployability in heterogeneous edge-cloud environments.},
  keywords={Servers;Microservice architectures;Collaboration;Scalability;Resource management;Measurement;Decision making;Adaptation models;Spatiotemporal phenomena;Reinforcement learning;Microservice Autoscaling;Edge-cloud Environ ment;Quality of Service;Service-Level Agreements;Graph Convolutional Network;Multi-Agent Reinforcement Learning},
  doi={10.1109/TSC.2026.3672566},
  ISSN={1939-1374},
  month={},}@INPROCEEDINGS{11401427,
  author={Raja, A Wasim and R, Rakisha and R, Ranga Nithilesh and V, Saran},
  booktitle={2025 IEEE First International Conference on Innovations in Engineering and Next-Generation Technologies for Sustainability (ICINVENTS)}, 
  title={Optimized Resource Allocation for Homeless Shelter Management}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={Homelessness represents a critical societal challenge requiring efficient resource management and strategic allocation to maximize impact. Traditional shelter management systems often operate with limited resources, reactive approaches, and inadequate predictive capabilities, resulting in suboptimal utilization of beds, supplies, and services. This paper proposes an Optimized Resource Allocation System (ORAS) powered by machine learning and data analytics that integrates demand forecasting, dynamic bed allocation, inventory management, and service coordination. Unlike existing shelter management approaches, the ORAS emphasizes predictive modeling, real-time optimization, and equitable resource distribution by leveraging historical occupancy patterns, weather data, socioeconomic indicators, and collaborative filtering techniques. The framework ensures efficient operations through automated decision support, demand-supply matching, and multi-objective optimization strategies. The system not only enhances operational efficiency but also improves service quality, reduces resource wastage, and supports evidence-based policy making for homeless services.},
  keywords={Weather;Technological innovation;Demand forecasting;Machine learning;Predictive models;Real-time systems;Resource management;Sustainable development;Socioeconomics;Optimization;Optimized Resource Allocation;Shelter Management;Predictive Analytics;Machine Learning;Homeless Services;Demand Forecasting;Operations Research},
  doi={10.1109/ICINVENTS64613.2025.11401427},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{7752377,
  author={Cintia, Paolo and Coscia, Michele and Pappalardo, Luca},
  booktitle={2016 IEEE/ACM International Conference on Advances in Social Networks Analysis and Mining (ASONAM)}, 
  title={The Haka network: Evaluating rugby team performance with dynamic graph analysis}, 
  year={2016},
  volume={},
  number={},
  pages={1095-1102},
  abstract={Real world events are intrinsically dynamic and analytic techniques have to take into account this dynamism. This aspect is particularly important on complex network analysis when relations are channels for interaction events between actors. Sensing technologies open the possibility of doing so for sport networks, enabling the analysis of team performance in a standard environment and rules. Useful applications are directly related for improving playing quality, but can also shed light on all forms of team efforts that are relevant for work teams, large firms with coordination and collaboration issues and, as a consequence, economic development. In this paper, we consider dynamics over networks representing the interaction between rugby players during a match. We build a pass network and we introduce the concept of disruption network, building a multilayer structure. We perform both a global and a micro-level analysis on game sequences. When deploying our dynamic graph analysis framework on data from 18 rugby matches, we discover that structural features that make networks resilient to disruptions are a good predictor of a team's performance, both at the global and at the local level. Using our features, we are able to predict the outcome of the match with a precision comparable to state of the art bookmaking.},
  keywords={Games;Nonhomogeneous media;Sensors;Performance evaluation;Sports equipment;Interrupters;Electronic mail},
  doi={10.1109/ASONAM.2016.7752377},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11137847,
  author={Fang, Bruce and Gao, Danyi},
  booktitle={2025 7th International Conference on Artificial Intelligence Technologies and Applications (ICAITA)}, 
  title={Collaborative Multi-Agent Reinforcement Learning Approach for Elastic Cloud Resource Scaling}, 
  year={2025},
  volume={},
  number={},
  pages={415-419},
  abstract={This paper addresses the challenges of rapid resource variation and highly uncertain task loads in cloud computing environments. It proposes an optimization method for elastic cloud resource scaling based on a multi-agent system. The method deploys multiple autonomous agents to perceive resource states in parallel and make local decisions. While maintaining the distributed nature of the system, it introduces a collaborative value function to achieve global coordination. This improves the responsiveness of resource scheduling and enhances overall system performance. To strengthen system foresight, a lightweight state prediction model is designed. It assists agents in identifying future workload trends and optimizes the selection of scaling actions. For policy training, the method adopts a centralized training and decentralized execution reinforcement learning framework. This enables agents to learn effectively and coordinate strategies under conditions of incomplete information. The paper also constructs typical cloud scenarios, including multi-tenancy and burst traffic, to evaluate the proposed method. The evaluation focuses on resource isolation, service quality assurance, and robustness. Experimental results show that the proposed multi-agent scaling strategy outperforms existing methods in resource utilization, SLA violation control, and scheduling latency. The results demonstrate strong adaptability and intelligent regulation. This provides an efficient and reliable new approach to solving the problem of elastic resource scaling in complex cloud platforms.},
  keywords={Training;Cloud computing;Job shop scheduling;Scalability;Collaboration;Reinforcement learning;Dynamic scheduling;Resource management;Thermal stability;Multi-agent systems;Multi-agent system;elastic expansion;resource scheduling;reinforcement learning},
  doi={10.1109/ICAITA67588.2025.11137847},
  ISSN={},
  month={June},}@ARTICLE{11224399,
  author={Bao, Tingting and Li, Xin and Zhao, Yongli and Lian, Meng and Jiang, Yike and Zhang, Jie},
  journal={Journal of Optical Communications and Networking}, 
  title={Joint optimization of DNN model partitioning and slice delivery for distributed edge-cloud inference over optical networks}, 
  year={2025},
  volume={17},
  number={11},
  pages={1047-1058},
  abstract={With the increasing demand for low-latency deep neural network (DNN) inference, edge-cloud collaborative inference has become a promising paradigm. However, the increasing diversity of models, coupled with the limited and heterogeneous resources of edge nodes, makes it impractical to pre-deploy all models at the edge. These constraints not only intensify the complexity of model partitioning and slice delivery but also impose stricter requirements on scheduling and resource coordination. To address these challenges, this paper proposes a joint optimization approach for model partitioning and slice delivery to improve inference performance. We first formulate a mixed-integer nonlinear programming (MINLP) model for exact optimization. A heuristically seeded genetic algorithm (HSGA) is further developed, which incorporates heuristic initialization and task-driven alternating evolution to improve solution quality and convergence speed. Simulation results demonstrate that the proposed algorithm significantly reduces both the task completion time and blocking rate, validating its effectiveness in complex edge-cloud environments.},
  keywords={Computational modeling;Servers;Delays;Collaboration;Optimization;Data models;Inference algorithms;Bandwidth;Scheduling;Partitioning algorithms},
  doi={10.1364/JOCN.575114},
  ISSN={1943-0639},
  month={November},}@ARTICLE{11096407,
  author={Wu, Qianqian and Xie, Yuejiao and Wang, Ke and Pun, Man-on},
  journal={IEEE Geoscience and Remote Sensing Magazine}, 
  title={Optimizing Collaborative Space–Air–Ground Earth Observation: A decision-making perspective}, 
  year={2025},
  volume={13},
  number={4},
  pages={325-345},
  abstract={Earth observation (EO) tasks play a critical role in addressing the diverse and complex data needs of users. However, fully satisfying these demands presents significant challenges. To cope with this obstacle, cross-platform observation systems utilizing satellites, aircraft, and ground geosensors have been developed to enhance data acquisition through coordinated efforts. Despite the fact that the complementary characteristics of these platforms can improve observation quality, their heterogeneity complicates efficient coordination. To enhance the efficiency of collaborative observation and better fulfill the requirements of EO, numerous space–air–ground coordination methods have been proposed, primarily focusing on decision making and optimization during the data acquisition phase. Nevertheless, a comprehensive synthesis of these strategies remains lacking. This article, therefore, provides a systematic review of existing collaborative observation strategies and decision-making processes in observation planning. We review various sensor assessment and planning techniques, aiming to categorize existing approaches while providing insights into emerging research trends. Additionally, we comparatively discuss examples of these approaches in both routine and emergency observation tasks, offering insights into their practical application across different observation tasks.},
  keywords={Collaboration;Planning;Decision making;Earth;Scheduling;Satellites;Optimal scheduling;Monitoring;Data collection;Data acquisition},
  doi={10.1109/MGRS.2025.3586570},
  ISSN={2168-6831},
  month={Dec},}@INPROCEEDINGS{10393945,
  author={Fang, Scott and Hou, Ming and Pavlovic, Nada and Banbury, Simon and Gamble, Murray and O'Young, Siu},
  booktitle={2023 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={Development of a Soldier-Robot Teaming Synthetic Environment for Team Effectiveness Evaluation}, 
  year={2023},
  volume={},
  number={},
  pages={4871-4876},
  abstract={To help enhance mission effectiveness for future dismounted soldiers in the Canadian Armed Forces (CAF), a Soldier-Robot Teaming (SRT) concept has been developed and accepted as a force multiplier to extend operational abilities of dismounted soldiers in the battlefield, such as reducing the number of soldiers in dangerous environments and empowering them with advanced robot technologies. To support this endeavour, the Defence Research and Development Canada (DRDC) Toronto Research Centre (TRC) has led a research effort 'Concept of Operations (CONOPS) for SRT in the CAF’ since 2019. In the first research phase, key stakeholders within the Department of National Defence (DND) and CAF were engaged in a series of meetings and interviews to help identify future SRT concepts across a broad range of missions and operational environments. During the stakeholder analysis, five SRT use cases were developed and validated for the CAF to capture the intended SRT CONOPS, operational priorities, operational contexts, functionality, interactions, and expected mission performance, and to support Land Operations at section and platoon levels. To further facilitate SRT concept development and experimentation activities at DRDC TRC, a synthetic modeling and simulation environment was proposed and developed, in support of future SRT effectiveness research on team communication, coordination, collaboration and trust. In the meantime, this effort can also support studies on human-machine interface and human-systems integration, as well as help carry out SRT human-in-the-loop experiments and trials, for the CAF needs of reducing soldier workload and improving team performance and effectiveness in future SRT operations.},
  keywords={Training;Robot kinematics;Human-machine systems;Laboratories;Particle measurements;Human in the loop;Stakeholders;synthetic environment;soldier-robot teaming;team effectiveness;human-machine interface;human-systems integration},
  doi={10.1109/SMC53992.2023.10393945},
  ISSN={2577-1655},
  month={Oct},}@INPROCEEDINGS{11434339,
  author={Tanna, Miren},
  booktitle={2025 3rd International Conference on Advances in Computation, Communication and Information Technology (ICAICCIT)}, 
  title={A Federated Approach to IoT-Based Decision Making System for Food Waste Prevention in Retail Industry: A Comprehensive Approach to Sustainable Operations}, 
  year={2025},
  volume={1},
  number={},
  pages={1457-1461},
  abstract={Food waste in the retail industry represents a critical challenge, with approximately $30-40 \%$ of the food produced in the U.S being lost or wasted throughout the food supply chain. The literature analysis reveals significant advancements in IoT applications for food safety monitoring, with studies demonstrating waste reduction through intelligent sensor deployment and machine learning-enhanced quality assessment systems. This paper proposes a novel federated learning-enhanced Internet of Things (IoT) based decisionmaking system, a framework that enables collaborative food waste prevention across non-affiliated retail organizations while preserving competitive advantages. The framework integrates a four-tier architecture comprising of Data Collection Layer with advanced sensor networks and RFID tracking, Intelligent Processing Layer with machine learning algorithms, Federated Learning Coordination Layer for privacy-preserving multiretailer collaboration, and Decision Execution Layer for automated waste prevention actions. The federated learning innovation enables retailers to collectively train superior prediction models for demand forecasting, spoilage detection, and dynamic pricing without sharing sensitive operational data. The proposed system addresses critical gaps in current reactive waste management approaches by providing a collaborative intelligence system for retail food waste prevention.},
  keywords={Food waste;Prevention and mitigation;Biological system modeling;Supply chains;Standards organizations;Collaboration;Organizations;Internet of Things;Optimization;Collaborative intelligence;Federated Learning;Internet of Things;Decision Support Systems;Food waste prevention;Smart Retail Technology;Machine Learning;Predictive Analytics;Supply Chain Optimization},
  doi={10.1109/ICAICCIT68829.2025.11434339},
  ISSN={},
  month={Oct},}@ARTICLE{11450526,
  author={Feng, Xingyu and Yang, Huanqi and Chen, Zhuangzhuang and Luo, Chengwen and Wang, Yuzhu and Zhou, Zhangbing and Xu, Weitao and Leung, Victor C.M.},
  journal={IEEE Transactions on Mobile Computing}, 
  title={E $^{2}$ LLM: Structure-Guided Efficient Inference for LLMs in Distributed Edge-IoT Environments}, 
  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={Large language models (LLMs) are increasingly deployed in edge computing environments to reduce latency and preserve privacy. However, their inference process presents fundamental challenges for resource-constrained IoT devices. LLM inference involves computationally asymmetric stages: parallelizable prompt processing and sequential token decoding. This asymmetry creates deployment bottlenecks where IoT devices lack capacity for prompt processing while edge nodes suffer from inefficient sequential decoding. This paper presents E $^{2}$ LLM, an efficient distributed inference framework for large language models in heterogeneous edge-IoT environments. E $^{2}$ LLM leverages high-capacity edge devices for structural planning and introduces auxiliary lightweight models to generate segment-specific key-value (KV) caches. These minimal inference artifacts enable collaborative parallel decoding across IoT devices without requiring full model instantiation. The framework employs static-dynamic KV cache separation to minimize communication overhead while maintaining semantic coherence through structure-guided coordination. Extensive evaluation on realistic edge testbeds demonstrates significant performance improvements. Under diverse deployment settings, E $^{2}$ LLM achieves 74%–87.7% end-to-end latency reduction compared with several state-of-the-art baselines, while maintaining comparable generation quality; meanwhile, it also delivers a 34.6%–72.2% reduction in communication overhead, improves 9-12 × in energy efficiency. The framework exhibits strong scalability under bandwidth-limited conditions, enabling efficient LLM deployment across heterogeneous edge-IoT environments.},
  keywords={Decoding;Computational modeling;Internet of Things;Vectors;Semantics;Collaboration;Transformers;Biological system modeling;Bandwidth;Performance evaluation;Large language models;Collaborative;Distributed inference},
  doi={10.1109/TMC.2026.3676689},
  ISSN={1558-0660},
  month={},}@INPROCEEDINGS{11025466,
  author={Chen, Xiaoqun and Hong, Zhe and Jiang, Xiaokun},
  booktitle={2024 5th International Conference on Information Science and Education (ICISE-IE)}, 
  title={The Spatiotemporal Evolution and Development Curve Simulation of China's Urban Agglomerations in the Construction of a Digital Basic Public Service System}, 
  year={2024},
  volume={},
  number={},
  pages={542-557},
  abstract={The construction of regional basic public service systems often coincides with the formation and development of urban agglomerations, driven by economies of scale that promote cooperative interactions among cities. The digital basic public service system within urban agglomerations exhibits a wave-like climbing trend over time. This study investigates the fundamental principles of this climbing trend, derives a geometric expression through a mathematical model, and establishes a comprehensive evaluation framework integrating digital development and basic public service systems. Using the entropy method and a coupling coordination degree model, the study measures and analyzes the construction levels and spatiotemporal evolution of digital basic public services across urban agglomerations and their constituent cities. A joint strength and threshold model is developed to assess the collaborative intensity of digital basic public services within urban agglomerations, and Matlab simulation is employed to validate the climbing trend of construction levels over time. The findings indicate that the construction level of digital basic public services in China's urban agglomerations is steadily improving, adhering to the climbing trend, though spatial distribution remains uneven, with higher levels in coastal areas and the Yangtze River Economic Belt. The joint strength of digital basic public services among cities within urban agglomerations continues to increase but is constrained by thresholds, with varying breakthrough timings across different urban agglomerations. The wave-like climbing curve of construction levels over time and urban joint development is empirically validated with a strong fit. This research provides quantitative evidence for advancing the integration of digital public service systems within urban agglomerations and offers theoretical and algorithmic guidance to promote the equalization of regional basic public services.},
  keywords={Couplings;Technological innovation;Urban areas;Collaboration;Transportation;Strategic planning;Market research;Mathematical models;Rivers;MATLAB;China’s Urban Agglomerations;Digital Basic Public Service System Construction;Climbing Trend;Joint Threshold;Simulation Validation},
  doi={10.1109/ICISE-IE64355.2024.11025466},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10751308,
  author={Hermanus, Davy Ronald and Supangkat, Suhono Harso and Hidayat, Fadhil},
  booktitle={2024 International Conference on ICT for Smart Society (ICISS)}, 
  title={Designing an Advanced Situational Awareness Platform Using Intelligent Multi-Drones for Smart Farming Towards Agriculture 5.0}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With regard to Agriculture 5.0, the goal of this research is to create an intelligent platform for multi-drone collaboration that will improve situational awareness. This study examines the crucial phases in the Sensing, Understanding, and Action processes by fusing cutting-edge drone technology with creative coordination methods. Creating the architecture and foundation for drone collaboration, utilizing artificial intelligence for real-time data processing, and creating user interfaces that work are all part of the study technique. Area coverage, data quality, processing speed, and decision-making effectiveness are some of the performance evaluation measures. The goal of the research is to identify strategies for enhancing large-scale farming methods' resource management and operational effectiveness. The results will greatly enhance Agriculture 5.0 technologies and create avenues for the deployment of multi-drone collaboration platforms in a variety of high-situational awareness businesses.},
  keywords={Smart agriculture;Decision making;Collaboration;Predictive models;Real-time systems;Artificial intelligence;Sustainable development;Intelligent sensors;Drones;Farming;Agriculture 5.0;Multi-Drone Collaboration;Situational Awareness;Real-Time Data Analysis;Artificial Intelligence (AI)},
  doi={10.1109/ICISS62896.2024.10751308},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{7851764,
  author={Xu, Xiaolong and Lijun Yang and Kong, Yuanyuan},
  booktitle={2016 IEEE International Conference on Teaching, Assessment, and Learning for Engineering (TALE)}, 
  title={Multi-disciplinary collaborative innovation capacity training scheme}, 
  year={2016},
  volume={},
  number={},
  pages={18-25},
  abstract={Due to the highly integrated trend of technologies, creating a new high-tech product requires close and efficient collaborative innovation and cooperation of the research and development (R & D) team consisting of various professional talents. The multi-disciplinary collaborative innovation capacity should be cultivated in the undergraduate phase. In response to this demand, we present the multi-disciplinary collaborative innovation capacity training scheme. Based on complex projects involving multiple disciplines, a four-dimensional (professional, role, task and ability) collaborative innovation capacity training scheme is proposed: the team members are assigned with different transactional roles in accordance with their characteristics and tendencies, and they are also allocated with R & D tasks in accordance with their professional attributes and strengths. In the process of R & D projects, students from different majors can not only understand their professional knowledge better and develop their research capability, but also learn from other members' professional knowledge practically, and master the cooperation skills. As a result, both their collaboration ability and teamwork spirit are enhanced. While students receive scientific and technological knowledge, their sense of innovation and creative potential are inspired. The comprehensive features of robotics technology and the breadth of robotics applications make robots an ideal interdisciplinary and intersecting education and practice platform. We adopt the robot project as a typical case and platform to put the proposed training mode and the five-phase training process into practice, which provides a good reference for the practical application.},
  keywords={Technological innovation;Teamwork;Training;Educational robots;multi-disciplinary;collaborative innovation;Synergy;robot project;training scheme},
  doi={10.1109/TALE.2016.7851764},
  ISSN={2470-6698},
  month={Dec},}@INPROCEEDINGS{11451494,
  author={Xiaoxiao, Zhu and Hua, Li and Yaoting, Xu and Jie, Dong and Yaohua, Jin},
  booktitle={2026 IEEE International Conference on Power, Electronics and Green Energy (ICPEGE)}, 
  title={A Novel Coordinated Optimisation Control Method for Power System Generation, Transmission, Load and Storage Based on Multimodal Large Models}, 
  year={2026},
  volume={},
  number={},
  pages={441-446},
  abstract={With the continuous increase in renewable energy penetration and the widespread integration of flexible loads within new power systems, traditional source-grid-load-storage coordinated control methods face challenges including difficulties in fusing high-dimensional heterogeneous data, complex multi-timescale coupling, and acute conflicts of interest among multiple stakeholders. This paper proposes a collaborative optimisation control framework for source-grid-load-storage systems based on multimodal large models. By establishing cross-modal representation learning within a unified semantic space, it achieves deep integration of multi-source heterogeneous data encompassing grid topology, equipment status, meteorological conditions, and load characteristics. A collaborative decision-making mechanism for the four stakeholders (generation, grid, load, and storage) is designed. Regional grid control is modelled as a partially observable Markov decision process, solved using an improved multi-agent near-term policy optimisation algorithm. Experimental results on a provincial grid dataset demonstrate significant improvements over traditional methods in key metrics including renewable energy absorption rate, voltage quality, and control efficiency: Renewable energy curtailment rates decreased by 4.2 percentage points to 1.8%, voltage deviations reduced by 37.5%, control response times shortened to under 200 milliseconds, and false alarms decreased by 286,000 per annum. These findings validate the method's effectiveness and advanced capabilities within complex, uncertain environments.},
  keywords={Renewable energy;Semantics;Collaboration;Power systems;Topology;Stakeholders;Time factors;Voltage control;Optimization;Load modeling;Multimodal large-scale models;Source-grid-load-storage coordination;New power systems;Deep reinforcement learning;Optimisation control},
  doi={10.1109/ICPEGE67691.2026.11451494},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11348877,
  author={Gao, Shengyang and Zhang, Xinyu},
  booktitle={2025 IEEE 7th International Conference on Civil Aviation Safety and Information Technology (ICCASIT)}, 
  title={AIGC Video Script Generation and Visual Collaborative Optimization Based on Large Language Model (LLM)}, 
  year={2025},
  volume={},
  number={},
  pages={823-828},
  abstract={This paper focuses on the problem of AIGC video script generation and visual collaborative optimization, proposes a video script generation algorithm guided by semantics and vision, and constructs a visual collaborative optimization model based on multimodal fusion. The algorithm realizes the coordination of script semantic understanding and visual expression by bidirectional mapping of semantic and visual features; the model integrates multimodal data to improve the visual effect of the video. The experiment constructs a dataset containing 1,000 sets of film and television, advertising video samples and their corresponding text descriptions. In the Python 3.8 and PyTorch environment, the script semantic rationality, visual matching, video fluency, etc. are used as evaluation indicators to compare with traditional rule-based algorithms and single language model algorithms. The results show that the script semantic rationality score of the algorithm in this paper is 89.5 points, which is 23% higher than the traditional rule-based algorithm and 15% higher than the single language model algorithm; the visual matching score is 88.2 points, which is 28% and 20% higher respectively; the video fluency score is 87.6 points, which is 25% and 18% higher respectively. After being processed by the visual collaborative optimization model, the visual coherence of the video screen is improved by 30%. Experiments show that the algorithm and model significantly improve the quality and visualization effect of AIGC video script generation, providing an efficient technical path for video creation.},
  keywords={Visualization;Solid modeling;TV;Optimization models;Large language models;Semantics;Collaboration;Data models;Optimization;Videos;Large language model;AIGC;video script generation;visual collaborative optimization;semantic-visual bidirectional guidance algorithm},
  doi={10.1109/ICCASIT66611.2025.11348877},
  ISSN={},
  month={Oct},}@ARTICLE{10286814,
  author={Khattak, Kausar-Nasreen and Qayyum, Faiza and Naqvi, Syed Shehryar Ali and Mehmood, Asif and Kim, Jungsuk},
  journal={IEEE Access}, 
  title={A Systematic Framework for Addressing Critical Challenges in Adopting DevOps Culture in Software Development: A PLS-SEM Perspective}, 
  year={2023},
  volume={11},
  number={},
  pages={120137-120156},
  abstract={DevOps is the bundle of applications and culture activity that focuses to separate the challenges between evaluation and performance associates to boost participation and communication. Several companies clutch DevOps fundamentals due to tremendous perspectives, like small tempo for production, rise accuracy, and durability. In contempt of the global assumption of DevOps and its framework, there is an absence of interpretation studies and essential ideas, implementation, and issues related to executing DevOps procedures. The major objective of this research study is to investigate and study issues affiliated with the DevOps culture (DVC) and applications. The challenges that are challenging in adopting DevOps culture in software development (SD) are inspected by conducting the systematic literature review (SLR). Furthermore, it explains the working of DevOps in industries, gives full clarification of DevOps, and probes the cultural issues faced by the industries while executing DevOps. This study discloses ten barriers that should be declamation in accepting DevOps culture. In accordance with the discoveries, these ten barriers contemplate during the execution of DevOps culture i.e. lack of collaboration and coordination, Lack of skill and knowledge, complicated infrastructure, Lack of management, Lack of DevOps approach, and trust confidence problems.},
  keywords={Software packages;Systematics;Companies;Surveys;Stakeholders;Software development management;Cultural aspects;PLS-SEM;DevOps culture;DevOps;challenges to adopt DevOps;systematic literature review (SLR);software development},
  doi={10.1109/ACCESS.2023.3325325},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9350853,
  author={Huang, Shuokang and Chen, Ruibiao and Li, Yu and Zhang, Meimei and Lei, Kai and Xu, Ting and Yu, Xiquan},
  booktitle={2020 3rd International Conference on Hot Information-Centric Networking (HotICN)}, 
  title={Intelligent Eco Networking (IEN) III: A Shared In-network Computing Infrastructure towards Future Internet}, 
  year={2020},
  volume={},
  number={},
  pages={47-52},
  abstract={Intelligent Eco Networking (IEN) makes significant progress to be a shared in-network computing infrastructure towards the future Internet, owing to its value-oriented ideology, content-centric fashion, intelligent collaborative management, and decentralized consensus trust preservation. Comprehensively uniting resources of computing, storage, and network, IEN executes the computing tasks in the network layer with name-based functions, integrating the SDN-like collaborative schedule and coexisting with the current TCP/IP via network slicing. To gradually evolve to be an advanced networking ecosystem, IEN copes with ultra-low latency, massive connections, and large-scale coverage to sustain the new rising information services. The simple evaluations demonstrate the profound potential of IEN in settling the in-network computing, providing the practical foundation for the multimodal computing paradigm in the future Internet.},
  keywords={Schedules;Collaboration;TCPIP;Internet;Resource management;Reliability;Task analysis;In-network Computing;Future Internet;ICN;SDN;Blockchain},
  doi={10.1109/HotICN50779.2020.9350853},
  ISSN={},
  month={Dec},}@ARTICLE{10740662,
  author={Li, Na and Yuan, Fanghao and Li, Yan and Lv, Wenwen},
  journal={IEEE Robotics and Automation Letters}, 
  title={Public Hospital's Decision Analysis on Providing E-Visit Services}, 
  year={2024},
  volume={9},
  number={12},
  pages={11577-11584},
  abstract={E-visits have emerged as a pivotal tool for enhancing both patients' medical experience and the efficient utilization of medical resources. By modeling stylized queueing models, this letter explores the optimal online medical resource allocation decision on providing e-visits in a public hospital, and examines the impact of the external Internet hospital on the public hospital's decision. The public hospital aims to maximize its utility by determining the optimal online medical resource allocation, while patients make their visit decisions based on utility. Results indicate that increased sensitivity of the revisit rate to resource allocation, or higher unit gain associated with e-visit patients (achieved from providing convenient access to medical services and minimizing cross-infection risks), prompts the public hospital to allocate more resources to e-visits. Notably, external Internet hospital price and capacity do not alter the basic influence patterns of the decision, but the resource allocation proportion increases with the external e-visit service price. Moreover, as the external e-visit service capacity expands, the optimal resource allocation proportion decreases when the sensitivity of the revisit rate is low (which indicates the quality is influenced slightly by resource allocation), and exhibits an initial decrease followed by an increase when the sensitivity is high.},
  keywords={Hospitals;Medical services;Internet;Resource management;Logic gates;Medical diagnostic imaging;Costs;Analytical models;Sensitivity;Collaboration;Health care management;planning, scheduling and coordination},
  doi={10.1109/LRA.2024.3490397},
  ISSN={2377-3766},
  month={Dec},}@ARTICLE{8486941,
  author={De Figueiredo, Felipe A. P. and Jiao, Xianjun and Liu, Wei and Mennes, Ruben and Jabandzić, Irfan and Moerman, Ingrid},
  journal={IEEE Access}, 
  title={A Spectrum Sharing Framework for Intelligent Next Generation Wireless Networks}, 
  year={2018},
  volume={6},
  number={},
  pages={60704-60735},
  abstract={The explosive emergence of wireless technologies and standards, covering licensed and unlicensed spectrum bands, has triggered the appearance of a huge amount of wireless technologies, with many of them competing for the same spectrum band instead of harmoniously sharing it. Unfortunately, the wireless spectrum is a scarce resource, and the available frequency bands will not scale with the foreseen demand for new capacity. Certain parts of the spectrum, in particular the license-free ISM bands, are overcrowded, while other parts, mostly licensed bands, may be significantly underutilized. As such, there is a need to introduce more advanced techniques to access and share the wireless medium, either to improve the coordination within a given band or to explore the possibilities of intelligently using unused spectrum in underutilized (e.g., licensed) bands. Therefore, in this paper, we present an open source software-defined radio-based framework that can be employed to devise disruptive techniques to optimize the sub-optimal use of radio spectrum that exists today. We describe three use cases where the framework can be employed along with intelligent algorithms to achieve improved spectrum utilization. In addition, we provide several experimental results showing the performance and effectiveness of the proposed framework.},
  keywords={Wireless networks;Next generation networking;Quality of service;Collaboration;Bandwidth;Broadband communication;Next generation wireless networks;cognitive radios;collaborative intelligent radio networks;spectrum sharing;coexistence;experimental evaluation},
  doi={10.1109/ACCESS.2018.2875047},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11366150,
  author={Gama, Laura Vanesa Delgado and Polo, Olga Lucía Mendez},
  booktitle={2025 Congreso Internacional de Innovación y Tendencias en Ingeniería (CONIITI)}, 
  title={Educational Robotics and Systemic Thinking in the Classroom, A Methodological Proposal}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={This article presents analytically the partial results of a methodological sequence based on educational robotics to strengthen systemic thinking, and from their achievement. Subsequently, the development of other topics more focused on the specific needs of the territory, in students from fourth to sixth grade of the Ramón Barrantes Technical Educational Institution in Pisba. Boyacá, Colombia. The study is structured as an iterative design in three stages called: (i) diagnostic evaluation, (ii) We are all a system, and (iii) perceiving the environment from a systemic thinking. From its implementation, it is concluded that it is an effective methodological sequence to facilitate the understanding of complex concepts through analogies, physical simulations and activities of construction and resolution of small enigmas in a collaborative way; encouraging communication during the process; the coordination of ideas, actions and actors, thus evidencing the synergies that can emerge from STEAM robotics activities in rural schools.},
  keywords={Training;Federated learning;Robot kinematics;Collaboration;Robot sensing systems;Sensor systems;Sensors;Systems thinking;Iterative methods;Proposals;Systems thinking;educational robotics;STEAM;synergy},
  doi={10.1109/CONIITI68560.2025.11366150},
  ISSN={2539-4320},
  month={Oct},}@INPROCEEDINGS{10747618,
  author={Diaz Triana, Oscar Augusto and Clavijo Bustos, Nelly and Reina, Fredy Angarita and Rodriguez Higuera, Guillermo and Oviedo Barbosa, Emelin Catherine},
  booktitle={2024 IEEE VII Congreso Internacional en Inteligencia Ambiental, Ingeniería de Software y Salud Electrónica y Móvil (AmITIC)}, 
  title={Data Governance Education: Preparing Systems Engineering Students for Current Organizational Needs}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study details the design and implementation of a Data Governance course using the ADDIE model and the Brightspace platform. The course aimed to develop data management competencies in systems engineering students through a blend of face-to-face and virtual scenarios and a participatory team-based methodology.Various instructional resources such as videos, readings, images, hypertext, and gamification tools catered to different learning styles, enriching the educational experience.International lectures and collaborative activities, like conceptual map creation, provided a global and practical perspective essential for understanding data governance.Continuous assessment, guided by Quality MattersTM Rubric Standards, ensured learning quality and facilitated course improvements. The Universidad Cooperativa de Colombia's Competency Evaluation System aligned evaluation activities with national and international standards.The Data Governance course successfully met its objectives, equipping students with the necessary tools and knowledge to address data management challenges in organizations. The course's structured instructional design and diverse resources were key to its success, underscoring the importance of adapting education to current needs in systems engineering.},
  keywords={Knowledge acquisition;Standards organizations;Education;Collaboration;Organizations;Data models;Software;Data governance;Systems engineering education;Videos;Data Governance;Instructional Design;Blended Learning;Competency Development},
  doi={10.1109/AmITIC62658.2024.10747618},
  ISSN={},
  month={Sep.},}
