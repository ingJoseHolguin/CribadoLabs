  number={},
  pages={111-115},
  abstract={Single-agent reinforcement learning has achieved remarkable results in fields such as gaming and robotic control. However, due to the dynamic nature of agents, non-stationary environments, and limited data acquisition, traditional online reinforcement learning in multi-agent systems (MAS) faces challenges such as inefficient data acquisition and training deadlocks. While offline reinforcement learning can address this dilemma, existing multi-agent offline methods suffer from shortcomings such as poor policy coordination, homogeneous data utilization, and difficulty adapting to high-dimensional environments. This paper proposes a multi-agent batch learning algorithm (MA-OBLO) that optimizes performance through modules such as dynamic weighted collaborative policy updates and attention-based data filtering. Experiments show that in the collaborative transport task, MA-OBLO achieved a 92.3% success rate with 30% expert samples, representing improvements of 23.8, 11.1, and 4.7 percentage points over ILCQL, CTDE-BCQ, and MA-CQL, respectively. SMAC achieved a 68.2% win rate on the most challenging map, outperforming the competing algorithms. During peak hours, the average waiting time for intelligent transportation was 28.3 seconds, and the congestion rate was 12.5%, representing improvements of 12.9% and 18.3% over MA-CQL. Furthermore, it achieved stable performance in the fewest rounds, requiring only $\mathbf{1, 2 0 0}$ rounds for collaborative transport, demonstrating minimal performance fluctuations, demonstrating its comprehensive advantages.},
  keywords={Training;Fluctuations;Heuristic algorithms;Data acquisition;Collaboration;Transportation;Reinforcement learning;Telecommunication traffic;System recovery;Multi-agent systems;Offline reinforcement learning;multi-agent systems;batch learning;policy coordination;attention mechanism;MA-OBLO algorithm;agent collaboration},
  doi={10.1109/IICSPI66775.2025.11438073},
