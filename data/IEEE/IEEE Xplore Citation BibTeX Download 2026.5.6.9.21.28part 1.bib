  month={May},}@INPROCEEDINGS{11441180,
  author={Chen, Yulong and Luan, Zhen and Tang, LinXiang and Zhi, Chengrui and Li, Xinyao and Zhou, Yang},
  booktitle={2025 5th International Conference on Electronic Communication, Computer Science and Technology (ECCST)}, 
  title={Closed-Loop Multi-Agent Smoke Screen Interference Collaborative Optimization Driven by “Planning - Memory - Reflection”}, 
  year={2025},
  volume={},
  number={},
  pages={76-81},
  abstract={This paper proposes and validates an autonomous cooperative decision-making system applying the “Plan-ning-Memory-Reflection” (PMR) closed-loop cognitive architecture to counter multiple incoming missiles using multi-UAV smoke screen interference. The paper models three aspects: geometric occlusion, cloud cluster dynamics, and task allocation with memory enhancement. By integrating heuristic candidate generation, a hybrid greedy-local refinement optimization, and a text-based reflection strategy iteration method, it achieves high-quality decision-making under stringent real-time and physical constraints. Simulations demonstrate that compared to traditional greedy and pure optimization methods, the PMR framework significantly reduces multi-missile/multi-UAV coordination latency and interruption probability while increasing total masking duration. The paper also presents sensitivity analysis, computational complexity evaluation, and scalability discussions for the model, proposing future extensions in wind field coupling, communication-impaired scenarios, and online learning.},
  keywords={Computational modeling;Decision making;Computer architecture;Interference;Predictive models;Real-time systems;Reflection;Hybrid power systems;Resource management;Jamming;Planning-Memory-Reflection;smoke-screen jamming;multi-UAV cooperation;occlusion optimization;task allocation},
  doi={10.1109/ECCST68196.2025.11441180},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11389883,
  author={Hsieh, Cheng-Yen and Jhong, Sin-Ye and Lin, Hsin-Chun and Li, Shang-Lin and Chen, Yung-Yao},
  booktitle={2025 International Conference on Automation Technology (Automation)}, 
  title={Embodied Multi-Agent Planning With LLMs: A Best-of-N Strategy for Efficient Cooperation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In this paper, we present a planning framework for multi-agent collaboration in embodied environments that leverages large language models (LLMs) as reasoning agents. To improve decision quality before execution, we adopt a Best-of-N generation strategy and select the final action plan via an LLM based self evaluation rubric that scores cooperation, task relevance, feasibility, and clarity. Experiments on RoCoBench (sweep and sort tasks) show that the LLM evaluated Best of N variant achieves higher success rates and more efficient motion than a vanilla RoCo baseline and a rule based Best of N variant, reducing environment steps and trajectory length. However, this comes with a clear trade off: substantially higher language model query cost. Concretely, the LLM evaluated variant attains the best average Success Rate and achieves the lowest Environment Steps and Trajectory Length, while incurring the highest average queries cost per episode. These results highlight the clear trade-off between planning quality and computational cost, and point to future work on reducing query overhead to enhance the scalability of LLM-guided multi-robot coordination in real-world deployments.},
  keywords={Costs;Automation;Scalability;Robot kinematics;Collaboration;Machine learning;Cognition;Planning;Trajectory;Multi-agent systems;Artificial Intelligence;Machine Learning;Computation and Language;Multi-agent Systems;Robotics},
  doi={10.1109/Automation66991.2025.11389883},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11437935,
  author={Qi, Bolin and Wang, Hongliang and Xiao, Jing and Wang, Xinggang},
  booktitle={2025 11th International Conference on Computer and Communications (ICCC)}, 
  title={Research and Application of Collaborative Office Technology for Intelligent Pollution Prevention and Control}, 
  year={2025},
  volume={},
  number={},
  pages={733-737},
  abstract={This article introduces an intelligent collaborative office model for pollution prevention and control, aimed at improving the efficiency and quality of pollution prevention and control work, and promoting the development of environmental protection. This model achieves cooperation and coordination among various departments by establishing common goals and plans, strengthening information sharing and communication, coordinating law enforcement and supervision, promoting technological innovation and achievement transformation, and establishing evaluation and feedback mechanisms. This model adopts an online pollution control platform and message queue technology to link with enterprise WeChat work accounts for message push, ensuring that pollution prevention and control tasks can be pushed and tracked at every stage, and targeted to specific groups of people. This new interactive mode effectively improves and replaces the drawbacks of early applications based on mobile SMS platforms, and has become an effective interactive strategy mechanism for information pollution prevention and control in recent years.},
  keywords={Technological innovation;Pollution;Target tracking;Social networking (online);Prevention and mitigation;Collaboration;Pollution control;Message services;Real-time systems;Protection;queue;Office collaboration;WeCom;pollution prevention},
  doi={10.1109/ICCC68654.2025.11437935},
  ISSN={2837-7109},
  month={Dec},}@INPROCEEDINGS{11338572,
  author={Mendes, Diego Caracas and Rodrigues, Edson Coelho and Farias, Emanuel Bandeira and Barbosa, Ícaro and Gomes, George A. M. and Neto, Joaquim Bento Cavalcante and Vidal, Creto Augusto and Leite, Antonio J. M.},
  booktitle={2025 27th Symposium on Virtual and Augmented Reality (SVR)}, 
  title={A Virtual Reality Application for the Rehabilitation of Children with Cerebral Palsy}, 
  year={2025},
  volume={},
  number={},
  pages={413-422},
  abstract={The development of virtual environments to support rehabilitation for various diseases and special needs has gained significant attention in recent years. These environments offer numerous advantages for patients and healthcare professionals, including increased motivation and engagement among patients and the possibility of objective and personalized monitoring of the rehabilitation process for professionals. These benefits become even more relevant when the target audience is children, considering the difficulties related to concentration and understanding of the situation by such young patients, as well as the psychological and emotional burden that clinical environments often impose on minors. This paper presents the development and evaluation of an immersive VR application designed to support physical therapy in pediatric patients. Built in collaboration with physiotherapists, the system employs a "slideshow" metaphor to guide children through interactive narratives within a tropical forest environment. The solution prioritizes simplicity of use for professionals and engagement for young users while enabling therapists to observe and stimulate cervical and cognitive functions. Initial testing with children aged 3 to 17 revealed positive responses, particularly in cervical movement stimulation and interaction quality, although cognitive abilities significantly influenced engagement. The results demonstrate the potential of VR as an effective and adaptable therapeutic aid, paving the way for future expansions, allowing flexible creation of different narratives, and also targeting other diverse neuropsychomotor conditions.},
  keywords={Pediatrics;Cerebral palsy;Medical treatment;Virtual environments;Psychology;Collaboration;Forestry;Monitoring;Testing;Diseases;Virtual Reality;Rehabilitation;Physical Therapy;Cerebral Palsy},
  doi={10.1109/SVR67689.2025.00061},
