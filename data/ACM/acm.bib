@article{10.1145/3134753,
author = {Yuan, Chien Wen and Hanrahan, Benjamin V. and Lee, Sooyeon and Rosson, Mary Beth and Carroll, John M.},
title = {I Didn't Know that You Knew I Knew: Collaborative Shopping Practices between People with Visual Impairment and People with Vision},
year = {2017},
issue_date = {November 2017},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {1},
number = {CSCW},
url = {https://doi.org/10.1145/3134753},
doi = {10.1145/3134753},
abstract = {It is important to support independent living for people with visual impairments (PVI). Part of this can be accomplished with individual assistive technologies. However, in this paper we emphasize the social and collaborative needs for PVI to fully integrate into society as equals. The study assesses how PVI collaborate with different types of sighted partners when shopping together. We chose to study grocery shopping because it is a critical and challenging task for PVI. We conducted field observations and in-depth interviews with five PVI and their sighted shopping partners, including spouses, caseworkers, and store-provided courtesy shoppers. We found several factors that modulated these collaborations with varying forms of common ground: 1) knowledge about how to assist PVI; 2) interpersonal knowledge resulting from common experience and interpersonal relationship history; and 3) knowledge of shopping as a practice. We discuss our findings with respect to the implications for designing collaborative interactions.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = dec,
articleno = {118},
numpages = {18},
keywords = {people with visual impairments, grocery shopping, common ground, collaboration, assistive technology, accessibility}
}

