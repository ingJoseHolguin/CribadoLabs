@inproceedings{10.1145/3308557.3308659,
author = {Chen, Bin and Nakajima, Kenji and Hatada, Koki and Yura, Junichi and Uyama, Masashi and Okabayashi, Keiju},
title = {Real-time collaborative system based on distributed data sharing method},
year = {2019},
isbn = {9781450366731},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3308557.3308659},
doi = {10.1145/3308557.3308659},
abstract = {Co-creation activities such as problem solving and ideation require people with different perspectives to gather at the same place to develop ideas effectively. Owing to time and space constraints, this is not always easy. We developed a real-time collaborative system that allows people to share and discuss ideas while participating remotely. This paper introduces a distributed data sharing method adopted to improve users' collaboration and describes the evaluation results demonstrating the maximum number of systems that can be optimally connected simultaneously.},
