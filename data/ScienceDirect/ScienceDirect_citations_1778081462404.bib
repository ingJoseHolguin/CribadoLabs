author = {Hans Pasman},
keywords = {Human error, Human factor, Human reliability, Occupational risk, Process safety performance indicators, Safety attitude, Safety culture},
abstract = {Human behavior and decision making are of decisive importance with respect to process safety and risk control. Human factors or human factor engineering covers many aspects serving the goal of adapting technology to human capabilities in sensing, information processing, and decision making without error. It has a direct effect on occupational health and safety. By occupational risk modeling ways to improve personal safety are found. Human error has been the object of many modeling studies, in part for data in predictive risk analysis but mostly to avoid errors. Error variability is large. Safety culture is an exponent of the organizational whole. It is greatly influenced by the attitude of leadership. It cannot be measured directly, but measurement of safety climate as a result of surveying supervisor–subordinate interactions is indicative. Monitoring safety performance indicators is important for observing trends in the cultural health of an organization.}
}
